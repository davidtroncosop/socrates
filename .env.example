# Claves para generar los videos de las lecciones (scripts locales).
# Copia este archivo como .env y completa los valores. .env no se versiona
# y estas claves nunca llegan a la app publicada.

# Fish Audio: https://fish.audio → API Keys
FISH_AUDIO_API_KEY=

# Voz de la narración: el ID del modelo de voz (aparece en la URL de la voz
# en fish.audio, o en tu voz clonada).
FISH_AUDIO_VOICE_ID=

# Bucket de R2 donde se suben los videos. La subida usa tu sesión de
# wrangler (`npx wrangler login`), así que no hacen falta claves de R2.
R2_BUCKET=socatres-videos
